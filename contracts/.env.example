# --- Deployment wallet ---
# Private key of the deployer account (Sepolia testnet only, no real funds).
# Get Sepolia ETH from https://sepoliafaucet.com or https://www.alchemy.com/faucets/ethereum-sepolia
PRIVATE_KEY=0x...

# --- RPC ---
# Free Sepolia RPC URL. Sources: Alchemy, Infura, or public https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# --- Verification ---
# Etherscan API key (works for Sepolia). Create at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# Copy to .env (gitignored) and fill in real values.

# Sepolia RPC endpoint
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of agent1.prove.eth's wallet - executes tasks and submits results
AGENT_PRIVATE_KEY=0x...

# Private key of VerificationOracle's creDON address (the same deployer key
# used in contracts/.env and cre-workflow/.env) - posts verification results
ORACLE_PRIVATE_KEY=0x...

# How often to poll for new events, in milliseconds (optional, default 5000)
POLL_INTERVAL_MS=5000
